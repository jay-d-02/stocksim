# 없어도 docker compose up 으로 바로 실행됩니다 (로컬 개발용 기본값).
# 외부에 공개할 때만 이 파일을 .env 로 복사해 값을 바꾸세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다.

# 세션 쿠키·비밀번호 찾기 링크 서명 키 (공개 배포 시 반드시 32자 이상 랜덤 문자열로)
#   만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   바꾸면 모든 사람이 로그아웃되고, 보낸 비밀번호 찾기 링크도 무효가 됩니다
SECRET_KEY=
# HTTPS로 공개할 때 true (쿠키에 Secure 플래그. http://localhost 는 Chrome·Edge·Firefox에서 그대로 동작)
SECURE_COOKIES=false

# 비밀번호 찾기 메일 (비워 두면 메일 대신 docker compose logs app 에 링크가 찍힘)
#   Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_USER=주소, SMTP_PASSWORD=앱 비밀번호(구글 계정 → 보안 → 앱 비밀번호)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 메일 속 링크 주소 (예: https://market-sim.xxxx.ts.net)
PUBLIC_URL=
# 개인정보 처리방침 화면에 보일 문의처 (예: 이메일)
PRIVACY_CONTACT=

# PostgreSQL
POSTGRES_USER=stocksim
POSTGRES_PASSWORD=stocksim
POSTGRES_DB=market_sim      # 볼륨을 처음 만들 때 생기는 DB
APP_DB=market_sim           # 앱이 쓰는 DB (없으면 앱이 시작할 때 만듦)

# 외부 공개: docker compose up 때 같이 띄울 것 (tunnel = 임시 주소, cloudflare / funnel = 고정 주소)
# COMPOSE_PROFILES=cloudflare
# Cloudflare 고정 터널 토큰 (Zero Trust → Networks → Tunnels → 터널 만들기 → Docker 명령의 --token 뒤 값)
CLOUDFLARE_TUNNEL_TOKEN=
# Tailscale Funnel: 인증 키 (비워 두면 처음 한 번 docker compose logs tailscale 에 로그인 링크가 뜸)
TS_AUTHKEY=
TS_HOSTNAME=market-sim

# 투자 공부 → 오늘의 뉴스 (실제 뉴스). 비워 두면 그 화면에 설정 안내만 보임
#   네이버 클라우드 콘솔 → NAVER API HUB → Application 등록(검색 API) → 인증 정보의 Client ID / Secret
#   개발자센터(developers.naver.com)의 예전 키는 2026-07-31부터 신규 발급이 안 되고 여기서는 쓰지 않음
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_DAILY_CAP=500          # 하루 호출 상한 (무료 한도 월 775,000건, 평소 사용은 하루 300건 안팎)

# DB 백업을 서버 밖으로도 복사할 곳 (deploy/backup.sh). rclone 에 등록한 이름:폴더 (예: gdrive:stocksim-backup)
#   비워 두면 서버 안(~/stocksim-backup)에만 남음. 설정 방법은 deploy/LINUX.md
RCLONE_REMOTE=

# 게임 규칙
START_CASH=10000000
FEE_RATE=0.00015            # 매수·매도 수수료
TAX_RATE=0.002              # 매도 거래세
